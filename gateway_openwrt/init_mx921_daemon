#!/bin/sh /etc/rc.common
# Mawson Station MX921 LoRa Gateway Daemon Init Script
START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/python
DAEMON_SCRIPT=/root/mx921_daemon.py

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" -u "$DAEMON_SCRIPT"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall python 2>/dev/null || true
}
